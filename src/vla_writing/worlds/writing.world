<?xml version="1.0" ?>
<!-- Self-contained Gazebo world for the UR5e writing demonstration. -->
<sdf version="1.6">
  <world name="vla_writing_world">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>80</iters><sor>1.3</sor></solver>
        <constraints><cfm>0.0</cfm><erp>0.2</erp><contact_max_correcting_vel>1.0</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.42 0.42 0.42 1</ambient>
      <background>0.72 0.76 0.82 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 2.5 0.25 -0.45 0.25</pose>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.25 0.35 -0.90</direction>
    </light>
    <light name="fill" type="point">
      <pose>-0.5 -0.8 1.8 0 0 0</pose>
      <diffuse>0.55 0.60 0.70 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <attenuation><range>4</range><constant>0.5</constant><linear>0.02</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.16 0.18 0.20 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The table centre is aligned under the paper at (0.39, 0.0515) m;
         its top face is z=0.517 m.  The paper lower face rests on this
         surface and its visible top is z=0.521 m. -->
    <include>
      <uri>model://writing_table</uri>
      <name>writing_table</name>
      <pose>0.39 0.0515 0 0 0 0</pose>
    </include>
    <!-- The paper model's origin is its top-left corner in X/Y; its link pose
         supplies the physical 4-mm thickness above the table. -->
    <include>
      <uri>model://writing_paper</uri>
      <name>writing_paper</name>
      <pose>0.18 0.20 0 0 0 0</pose>
    </include>
    <!-- Camera is centred on the sheet. -->
    <include>
      <uri>model://paper_camera</uri>
      <name>paper_camera</name>
      <pose>0.39 0.0515 0 0 0 0</pose>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.75 -2.10 1.65 0.75 0.0 2.20</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
