<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    Lightweight, simulation-friendly end effector for the writing demo.

    The upstream UR description deliberately stops at ``tool0``.  This macro
    adds a fixed two-finger gripper and a replaceable pen.  The fingers are
    fixed in the ROS 1/Gazebo demo so that no extra controller is required;
    their geometry still gives a clear visual indication of the gripper and
    leaves a stable attachment point for a future gripper controller.

    ``pen_tip`` is the contract frame used by the writing nodes and by the
    optional ink renderer.  The pen axis follows tool0 +Y in the official
    UR5e ``up`` pose, keeping the nib normal to the horizontal paper.
  -->
  <xacro:macro name="writing_gripper_pen" params="
      parent
      prefix:=''
      pen_length:=0.16
      pen_radius:=0.006
      pen_tip_radius:=0.004
      finger_width:=0.012
      finger_length:=0.095
      pen_mount_offset:=0.030">

    <!-- The fixed jaw gap is derived from the pen diameter.  With the
         defaults, each 12-mm finger is centred at +/-12 mm, so its inner
         face is at +/-6 mm and the 12-mm pen is exactly centred between them. -->
    <xacro:property name="pen_diameter" value="${2.0 * pen_radius}"/>
    <xacro:property name="finger_gap" value="${pen_diameter}"/>
    <xacro:property name="finger_center_offset"
                     value="${0.5 * (finger_gap + finger_width)}"/>
    <!-- The jaw centre coincides with the pen's one-quarter-from-top point:
         the fixed pen starts at pen_mount_offset and the quarter point is
         pen_length/4 farther along its +Y writing axis. -->
    <xacro:property name="jaw_center_y"
                     value="${pen_mount_offset + pen_length/4.0}"/>

    <!-- Mount and palm.

         The official UR5e tool0 frame is not the same as a conventional
         "gripper Z-up" frame.  In the writing pose used by this package,
         tool0 +Y points down toward the sheet, while tool0 +X/+Z span the
         horizontal tabletop.  The palm is therefore built in the X-Z plane
         (normal to +Y), and the two fingers extend in +Y.  This keeps the
         complete gripper parallel to the tabletop while the pen remains
         vertical, instead of making a vertical plate which only appears to
         be attached to the wrist in Gazebo.
    -->
    <link name="${prefix}gripper_mount_link">
      <visual>
        <!-- Cylinder axis is tool0 +Y (the pen axis). -->
        <origin xyz="0 0.015 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="0.035" length="0.03"/></geometry>
        <material name="gripper_dark"><color rgba="0.12 0.14 0.16 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0.015 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="0.035" length="0.03"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0.015 0" rpy="0 0 0"/>
        <mass value="0.08"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>
    <joint name="${prefix}tool0-gripper_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_mount_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_palm_link">
      <visual>
        <!-- X-Z plane, parallel to the tabletop. -->
        <origin xyz="0 0.015 0" rpy="0 0 0"/>
        <geometry><box size="0.10 0.030 0.075"/></geometry>
        <material name="gripper_body"><color rgba="0.30 0.32 0.35 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0.015 0" rpy="0 0 0"/>
        <geometry><box size="0.10 0.030 0.075"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0.015 0" rpy="0 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00012"/>
      </inertial>
    </link>
    <joint name="${prefix}gripper_mount-palm" type="fixed">
      <parent link="${prefix}gripper_mount_link"/>
      <child link="${prefix}gripper_palm_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Fixed fingers: visually a parallel gripper, no controller required.
         They extend down along +Y, i.e. the same direction as the pen.  The
         opposing X faces leave exactly one pen diameter between them. -->
    <link name="${prefix}gripper_left_finger_link">
      <visual>
        <origin xyz="${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <geometry><box size="${finger_width} ${finger_length} 0.025"/></geometry>
        <material name="finger_metal"><color rgba="0.55 0.57 0.60 1.0"/></material>
      </visual>
      <visual name="left_jaw_pad">
        <origin xyz="${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <geometry><box size="${finger_width} 0.024 0.032"/></geometry>
        <material name="jaw_rubber"><color rgba="0.08 0.08 0.08 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <geometry><box size="${finger_width} ${finger_length} 0.025"/></geometry>
      </collision>
      <collision name="left_jaw_pad_collision">
        <origin xyz="${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <geometry><box size="${finger_width} 0.024 0.032"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <mass value="0.03"/>
        <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.000002"/>
      </inertial>
    </link>
    <joint name="${prefix}palm-left_finger" type="fixed">
      <parent link="${prefix}gripper_palm_link"/>
      <child link="${prefix}gripper_left_finger_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_right_finger_link">
      <visual>
        <origin xyz="-${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <geometry><box size="${finger_width} ${finger_length} 0.025"/></geometry>
        <material name="finger_metal"><color rgba="0.55 0.57 0.60 1.0"/></material>
      </visual>
      <visual name="right_jaw_pad">
        <origin xyz="-${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <geometry><box size="${finger_width} 0.024 0.032"/></geometry>
        <material name="jaw_rubber"><color rgba="0.08 0.08 0.08 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="-${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <geometry><box size="${finger_width} ${finger_length} 0.025"/></geometry>
      </collision>
      <collision name="right_jaw_pad_collision">
        <origin xyz="-${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <geometry><box size="${finger_width} 0.024 0.032"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-${finger_center_offset} ${jaw_center_y} 0" rpy="0 0 0"/>
        <mass value="0.03"/>
        <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.000002"/>
      </inertial>
    </link>
    <joint name="${prefix}palm-right_finger" type="fixed">
      <parent link="${prefix}gripper_palm_link"/>
      <child link="${prefix}gripper_right_finger_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- A black barrel and a small nib.  In the official UR5e ``up`` state
         tool0 +Y points down toward the table, so the pen axis is +Y (a
         cylinder's native +Z axis is rotated by -90 degrees around X).
         ``pen_tip`` is the exact writing point. -->
    <link name="${prefix}pen_link">
      <visual>
        <origin xyz="0 ${pen_length/2.0} 0" rpy="-1.57079632679 0 0"/>
        <geometry><cylinder radius="${pen_radius}" length="${pen_length}"/></geometry>
        <material name="pen_body"><color rgba="0.03 0.03 0.04 1.0"/></material>
      </visual>
      <!-- Short collar overlaps the lower face of the palm and the top of the
           barrel.  It makes the fixed mechanical attachment unambiguous in
           Gazebo and prevents the pen from looking detached at camera zoom. -->
      <visual name="pen_grip_collar">
        <origin xyz="0 ${pen_mount_offset - 0.006} 0" rpy="-1.57079632679 0 0"/>
        <geometry><cylinder radius="${pen_radius * 1.5}" length="0.012"/></geometry>
        <material name="pen_collar"><color rgba="0.16 0.17 0.18 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 ${pen_length/2.0} 0" rpy="-1.57079632679 0 0"/>
        <geometry><cylinder radius="${pen_radius}" length="${pen_length}"/></geometry>
      </collision>
      <collision name="pen_grip_collar_collision">
        <origin xyz="0 ${pen_mount_offset - 0.006} 0" rpy="-1.57079632679 0 0"/>
        <geometry><cylinder radius="${pen_radius * 1.5}" length="0.012"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 ${pen_length/2.0} 0" rpy="-1.57079632679 0 0"/>
        <mass value="0.025"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="${prefix}palm-pen" type="fixed">
      <parent link="${prefix}gripper_palm_link"/>
      <child link="${prefix}pen_link"/>
      <!-- Explicit fixed mechanical mount from the gripper palm to the
           beginning of the pen barrel. -->
      <origin xyz="0 ${pen_mount_offset} 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}pen_tip">
      <!-- Keep this visual name stable: the Gazebo ink visual plugin locates
           the actual pen tip by searching for ``pen_tip_visual``. -->
      <visual name="pen_tip_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${pen_tip_radius}"/></geometry>
        <material name="ink_black"><color rgba="0.01 0.01 0.01 1.0"/></material>
      </visual>
      <collision name="pen_tip_collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${pen_tip_radius}"/></geometry>
        <surface>
          <friction><ode mu="0.8" mu2="0.8"/></friction>
          <contact><ode kp="1000000" kd="10"/></contact>
        </surface>
      </collision>
      <inertial>
        <mass value="0.002"/>
        <inertia ixx="0.00000001" ixy="0" ixz="0" iyy="0.00000001" iyz="0" izz="0.00000001"/>
      </inertial>
    </link>
    <joint name="${prefix}pen-pen_tip" type="fixed">
      <parent link="${prefix}pen_link"/>
      <child link="${prefix}pen_tip"/>
        <origin xyz="0 ${pen_length} 0" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo-only properties.  ``pen_tip`` is deliberately a real collision
         link, so a future contact/force plugin can subscribe without changing
         the robot description. -->
    <gazebo reference="${prefix}gripper_mount_link">
      <material>Gazebo/DarkGrey</material>
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="${prefix}gripper_palm_link">
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="${prefix}gripper_left_finger_link">
      <material>Gazebo/LightGrey</material>
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="${prefix}gripper_right_finger_link">
      <material>Gazebo/LightGrey</material>
      <selfCollide>false</selfCollide>
    </gazebo>
    <gazebo reference="${prefix}pen_link">
      <material>Gazebo/Black</material>
      <selfCollide>false</selfCollide>
      <gravity>false</gravity>
    </gazebo>
    <gazebo reference="${prefix}pen_tip">
      <material>Gazebo/Black</material>
      <selfCollide>false</selfCollide>
      <gravity>false</gravity>
    </gazebo>
  </xacro:macro>
</robot>
