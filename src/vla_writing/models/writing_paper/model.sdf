<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="writing_paper">
    <static>true</static>
    <link name="paper_link">
      <!-- Model origin is the paper's top-left corner.  +X is right and +Y
           is toward the top edge; the sheet therefore occupies
           x=[0,0.42], y=[-0.297,0]. -->
      <!-- The table top is z=0.517.  With 4-mm stock the lower face rests
           on that surface and the visible top/ink plane is z=0.521. -->
      <pose>0 0 0.519 0 0 0</pose>
      <collision name="collision">
        <pose>0.21 -0.1485 0 0 0 0</pose>
        <geometry><box><size>0.42 0.297 0.004</size></box></geometry>
      </collision>
      <visual name="paper_visual">
        <!-- Link centre z=0.515 and thickness 0.004 put the top face at
             z=0.517; the ink anchor below is placed exactly on that face. -->
        <pose>0.21 -0.1485 0 0 0 0</pose>
        <geometry><box><size>0.42 0.297 0.004</size></box></geometry>
        <material>
          <ambient>0.86 0.86 0.86 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <!-- Invisible top-left anchor.  The visual plugin is attached here so
           its local coordinates match the planner's paper_frame exactly. -->
      <visual name="ink_anchor_visual">
        <!-- Anchor is exactly at the visible top-paper reference plane. -->
        <pose>0 0 0.002 0 0 0</pose>
        <geometry><box><size>0.001 0.001 0.001</size></box></geometry>
        <material>
          <ambient>0 0 0 0</ambient>
          <diffuse>0 0 0 0</diffuse>
          <transparency>1.0</transparency>
        </material>
        <plugin name="ink_visual_plugin" filename="libink_visual_plugin.so">
          <paper_width>0.420</paper_width>
          <paper_height>0.297</paper_height>
          <write_z>0.0015</write_z>
          <contact_threshold>0.003</contact_threshold>
          <z_offset>0.0005</z_offset>
          <min_point_distance>0.001</min_point_distance>
          <pen_name_hint>pen_tip_visual</pen_name_hint>
          <material>Gazebo/Black</material>
        </plugin>
      </visual>
    </link>
    <!-- A very thin dark edge makes the sheet visible in the wide Gazebo shot. -->
    <link name="paper_border">
      <!-- This link uses model coordinates, not paper_link coordinates. -->
      <pose>0.21 -0.1485 0.5215 0 0 0</pose>
      <visual name="border_visual">
        <geometry><box><size>0.425 0.302 0.001</size></box></geometry>
        <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
