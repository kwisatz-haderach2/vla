<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="paper_camera">
    <static>true</static>
    <link name="camera_link">
      <!-- Gazebo cameras look along +X in their local frame.  Pitch +90 deg
           points +X down along world -Z. -->
      <pose>0 0 1.35 0 1.57079632679 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.08 0.08 0.06</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>0.08 0.08 0.06</size></box></geometry>
        <material><ambient>0.04 0.05 0.07 1</ambient><diffuse>0.08 0.10 0.14 1</diffuse></material>
      </visual>
      <sensor name="paper_camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.0</horizontal_fov>
          <image><width>800</width><height>600</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>5.0</far></clip>
        </camera>
        <plugin name="paper_camera_controller" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30.0</updateRate>
          <cameraName>paper_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>paper_camera_optical_frame</frameName>
          <robotNamespace>/vla</robotNamespace>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
