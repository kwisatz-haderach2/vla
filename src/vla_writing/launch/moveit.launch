<?xml version="1.0"?>
<launch>
  <!--
    Optional one-command MoveIt + Gazebo entry point.  The stock
    ur5e_moveit_config is reused for the semantic/planning files, while the
    custom URDF from writing_scene remains on /robot_description.  The local
    MoveIt launch maps to Gazebo's position trajectory controller.
  -->
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="enable_rviz" default="true"/>
  <arg name="use_sim_time" default="true"/>

  <include file="$(find vla_writing)/launch/writing_scene.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="enable_rviz" value="false"/>
  </include>

  <!-- Do not reload the plain UR5e URDF: planning_context consumes the custom
       UR5e+gripper+pen description already generated by writing_scene. -->
  <include file="$(find vla_writing)/launch/move_group_writing.launch"/>

  <node if="$(arg enable_rviz)" pkg="rviz" type="rviz" name="moveit_rviz"
        args="-d $(find ur5e_moveit_config)/launch/moveit.rviz" output="screen"/>
</launch>
