<?xml version="1.0"?>
<launch>
  <!-- Stable one-command entry point for the complete video demo. -->
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="enable_rviz" default="false"/>
  <arg name="show_paper_view" default="true"/>
  <include file="$(find vla_writing)/launch/writing.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="enable_rviz" value="$(arg enable_rviz)"/>
    <arg name="show_paper_view" value="$(arg show_paper_view)"/>
  </include>
</launch>
