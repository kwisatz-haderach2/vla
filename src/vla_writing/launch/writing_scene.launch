<?xml version="1.0"?>
<launch>
  <!--
    Canonical ROS 1 Noetic launch file for the complete writing scene.

    Usage:
      roslaunch vla_writing writing_scene.launch

    The URDF is generated from the official UR5e Gazebo macro and includes a
    fixed gripper/pen.  The table, paper and camera are regular SDF models in
    worlds/writing.world.  Set enable_rviz:=true for a second RViz view.
  -->
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="start_gazebo" default="true"/>
  <arg name="world_file" default="$(find vla_writing)/worlds/writing.world"/>
  <arg name="robot_xacro" default="$(find vla_writing)/urdf/writing_scene.urdf.xacro"/>
  <arg name="robot_name" default="ur5e_writing"/>
  <arg name="prefix" default=""/>
  <arg name="spawn_x" default="-0.15"/>
  <arg name="spawn_y" default="0.00"/>
  <arg name="spawn_z" default="0.10"/>
  <arg name="tf_prefix" default=""/>
  <arg name="robot_base_frame" default="base_link"/>
  <!-- Position control is the stable default for the writing/video branch.
       The effort controller remains in the YAML for the force-control branch;
       pass transmission_hw_interface:=hardware_interface/EffortJointInterface
       and controllers:=\"joint_state_controller eff_joint_traj_controller\"
       when handing control to that branch. -->
  <arg name="controllers" default="joint_state_controller pos_joint_traj_controller"/>
  <arg name="transmission_hw_interface" default="hardware_interface/PositionJointInterface"/>
  <arg name="initial_joint_positions" default="-J shoulder_pan_joint 0.0 -J shoulder_lift_joint -1.57 -J elbow_joint 1.57 -J wrist_1_joint -1.57 -J wrist_2_joint -1.57 -J wrist_3_joint 0.0"/>
  <arg name="enable_rviz" default="false"/>
  <arg name="rviz_config" default="$(find vla_writing)/rviz/writing_scene.rviz"/>
  <arg name="start_pen_monitor" default="true"/>
  <arg name="start_paper_view" default="false"/>
  <arg name="writing_config" default="$(find vla_writing)/config/writing.yaml"/>

  <!-- These are the top-left paper_frame coordinates from config/writing.yaml. -->
  <arg name="paper_origin_x" default="0.180"/>
  <arg name="paper_origin_y" default="0.200"/>
  <arg name="paper_origin_z" default="0.517"/>
  <arg name="paper_frame" default="paper_frame"/>
  <arg name="world_frame" default="world"/>

  <!-- Camera model is centred on the 0.42 x 0.297 m sheet. -->
  <arg name="camera_x" default="0.390"/>
  <arg name="camera_y" default="0.0515"/>
  <arg name="camera_z" default="1.350"/>
  <arg name="camera_frame" default="paper_camera_link"/>
  <arg name="camera_optical_frame" default="paper_camera_optical_frame"/>

  <!-- Make model://writing_table, model://writing_paper and model://paper_camera
       resolvable even when this is the only user package in a fresh shell. -->
  <env name="GAZEBO_MODEL_PATH" value="$(find vla_writing)/models"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <!-- The force interface is deliberately loaded as parameters only.  A ROS 2
       teammate can run the gateway in another terminal and use ros1_bridge;
       no ROS 2 executable is invoked from this ROS 1 launch file. -->
  <rosparam file="$(find vla_writing)/config/force_bridge.yaml" command="load" ns="vla"/>

  <!-- Expand the URDF before spawning Gazebo.  ``xacro`` is on PATH after
       sourcing /opt/ros/noetic/setup.bash (the normal Noetic workflow). -->
  <param name="robot_description"
         command="xacro --inorder '$(arg robot_xacro)' prefix:=$(arg prefix) transmission_hw_interface:=$(arg transmission_hw_interface)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch" if="$(arg start_gazebo)">
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
  </include>

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="publish_frequency" value="200.0"/>
    <param name="tf_prefix" value="$(arg tf_prefix)"/>
  </node>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_ur5e_writing" output="screen"
        args="-urdf -param robot_description -model $(arg robot_name) -x $(arg spawn_x) -y $(arg spawn_y) -z $(arg spawn_z) $(arg initial_joint_positions)"/>

  <!-- ros_control exposes the position trajectory interface used by the
       writing/video branch.  The effort controller is kept in the same YAML
       for the optional force-control hand-off, but is not spawned here. -->
  <rosparam file="$(find vla_writing)/config/ur5e_writing_controllers.yaml" command="load"/>
  <node pkg="controller_manager" type="spawner" name="writing_controller_spawner"
        output="screen" args="$(arg controllers)" respawn="false"/>

  <!-- paper_frame origin is the physical top-left of the sheet.  Logical
       layout coordinates use x=u and y=-v in this frame. -->
  <node pkg="tf" type="static_transform_publisher" name="paper_frame_broadcaster"
        args="$(arg paper_origin_x) $(arg paper_origin_y) $(arg paper_origin_z) 0 0 0 $(arg world_frame) $(arg paper_frame) 100"/>

  <!-- Gazebo's spawned URDF has no world link in the robot_state_publisher
       tree.  Publish the known spawn pose so MoveIt can transform
       base_link↔paper_frame and RViz can display both in one tree. -->
  <node pkg="tf" type="static_transform_publisher" name="world_robot_base_broadcaster"
        args="$(arg spawn_x) $(arg spawn_y) $(arg spawn_z) 0 0 0 $(arg world_frame) $(arg robot_base_frame) 100"/>

  <!-- The Gazebo camera looks along +X and is pitched down by +90 degrees. -->
  <node pkg="tf" type="static_transform_publisher" name="paper_camera_frame_broadcaster"
        args="$(arg camera_x) $(arg camera_y) $(arg camera_z) 0 1.57079632679 0 $(arg world_frame) $(arg camera_frame) 100"/>
  <node pkg="tf" type="static_transform_publisher" name="paper_camera_optical_frame_broadcaster"
        args="0 0 0 -1.57079632679 0 -1.57079632679 $(arg camera_frame) $(arg camera_optical_frame) 100"/>

  <!-- Actual pen pose/contact monitor.  It reads TF (not planned waypoints),
       which is also the source consumed by paper_view and the ROS2 force
       bridge. -->
  <node if="$(arg start_pen_monitor)" pkg="vla_writing" type="pen_monitor.py"
        name="pen_monitor" output="screen">
    <param name="config" value="$(arg writing_config)"/>
  </node>
  <node if="$(arg start_paper_view)" pkg="vla_writing" type="paper_view.py"
        name="paper_view" output="screen">
    <param name="config" value="$(arg writing_config)"/>
  </node>

  <node if="$(arg enable_rviz)" pkg="rviz" type="rviz" name="writing_rviz"
        args="-d $(arg rviz_config)" output="screen"/>
</launch>
