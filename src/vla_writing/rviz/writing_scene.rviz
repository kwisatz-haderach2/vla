Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz/Grid
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Enabled: true
      Links:
        All Links Enabled: true
      Name: UR5e + Gripper + Pen
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.08
      Name: TF Frames
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world:
          paper_frame:
            {}
          paper_camera_link:
            paper_camera_optical_frame: {}
      Update Interval: 0
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /vla/paper_camera/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Paper Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vla/scene_markers
      Name: Gazebo Scene (table + paper + camera)
      Namespaces:
        {}
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 52; 60
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.1
      Focal Point:
        X: 0.22
        Y: 0.02
        Z: 0.38
      Pitch: 0.48
      Yaw: 3.8
      Name: Current View
  Window Geometry:
    Height: 900
    Width: 1400
    X: 50
    Y: 50
